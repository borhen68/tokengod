# Public URL used in OAuth callbacks, OG images, and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Turso database. Keep the auth token server-only.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Optional for authenticated reactions. Add /auth/callback as an exact callback URL.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=

# Required only when X OAuth reactions are enabled. Signs the login cookie.
SESSION_SECRET=

# At least 32 random characters. Signs 30-minute, one-use verification receipts.
VERIFICATION_RECEIPT_SECRET=

# TokenGod's own Stripe account. This is separate from founders' read-only
# revenue keys and charges the $3 entry / optional Surface 3 backing.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
