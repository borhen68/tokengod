# Public URL used in OAuth callbacks, OG images, and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public DataFast site configuration. TokenGod's production values are used as
# fallbacks in the app; override these only for a separate analytics property.
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=dfid_7e2JjRMAMJP4ppGiuJAoj
NEXT_PUBLIC_DATAFAST_DOMAIN=tokengod.lol

# Turso database. Keep the auth token server-only.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Optional X account sessions. Public reactions do not require OAuth.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=

# Optional if VERIFICATION_RECEIPT_SECRET is set. Signs login and reaction cookies.
SESSION_SECRET=

# At least 32 random characters. Signs 30-minute, one-use verification receipts.
VERIFICATION_RECEIPT_SECRET=

# TokenGod's own Stripe account. This is separate from founders' read-only
# revenue keys and charges the $3 entry / optional Surface 3 backing.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
